#pragma once

// =====================================================================
//  CREDENZIALI — TEMPLATE.
//
//  Copia questo file in  secrets.h  (stessa cartella) e riempilo con i
//  tuoi dati:
//      copy secrets.h.example secrets.h        (Windows)
//      cp   secrets.h.example secrets.h        (bash)
//
//  secrets.h e' escluso dal .gitignore di radice e NON va committato:
//  questo repository e' pubblico. Se ti accorgi di averlo committato per
//  sbaglio, cambiare la password della rete e' piu' sicuro che riscrivere
//  la storia di git - una volta pubblicata, la vecchia password va
//  considerata compromessa.
// =====================================================================

// ---- Rete WiFi a cui connettersi ----
#define WIFI_SSID     "NomeDellaTuaRete"
#define WIFI_PASSWORD "PasswordDellaTuaRete"

// ---- Nome host sulla rete (mDNS) ----
// La board sara' raggiungibile come  <OTA_HOSTNAME>.local
// (es. ping wsoled-c3.local  /  http://wsoled-c3.local/update)
#define OTA_HOSTNAME  "wsoled-c3"

// ---- Password per l'upload da Arduino IDE (ArduinoOTA) ----
// Stringa vuota "" = nessuna password (sconsigliato su reti condivise).
#define OTA_PASSWORD  "cambiami"

// ---- Credenziali per la pagina web /update ----
// Utente vuoto "" = pagina senza autenticazione.
#define WEB_OTA_USER  "admin"
#define WEB_OTA_PASS  "cambiami"
